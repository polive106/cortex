{
  "name": "cortex",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "dev": "eve dev",
    "build": "eve build",
    "deploy": "eve deploy",
    "start": "eve start",
    "eval": "eve eval --agent companion-test",
    "eval:real": "eve eval --agent companion --strict",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "next typegen apps/web >/dev/null && tsc && tsc -p apps/web && pnpm -r typecheck",
    "test": "vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky",
    "test:watch": "vitest",
    "dev:web": "next dev apps/web",
    "build:web": "next build apps/web",
    "dev:eve": "eve dev",
    "dev:all": "vercel dev --local"
  },
  "dependencies": {
    "@cortex/domain": "workspace:*",
    "@shadcn/react": "0.3.1",
    "@shikijs/core": "3.23.0",
    "@shikijs/engine-javascript": "3.23.0",
    "@shikijs/engine-oniguruma": "3.23.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.0",
    "@vercel/connect": "2.7.0",
    "ai": "^7.0.172",
    "better-auth": "1.7.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eve": "^1.0.0-rc.17",
    "lucide-react": "1.16.0",
    "nanoid": "5.1.11",
    "next": "16.4.1",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shiki": "3.23.0",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "1.1.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.105",
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "^1.65.1",
    "@types/node": "26.x",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "just-bash": "^3.6.0",
    "typescript": "7.0.2",
    "vercel": "65.16.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "26.x"
  },
  "private": true,
  "packageManager": "pnpm@10.29.3"
}
